# =============================================================================
# V3_cursor_Cluster — Environment Configuration Example
# Copy to .env and fill in. NEVER commit .env.
# =============================================================================

# ---------- Gateway ----------

# Public host:port the gateway binds to
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8770

# Public URL the UI should use (must be reachable from uploader browser)
GATEWAY_PUBLIC_URL=http://localhost:8770

# Master admin API key (full access; use only for bootstrapping)
ADMIN_API_KEY=replace-me-with-64-hex-chars

# PostgreSQL connection (use PgBouncer in prod for connection pooling)
DATABASE_URL=postgresql://v3cluster:password@127.0.0.1:5432/v3cluster

# Storage root for originals + outputs
STORAGE_ROOT=/opt/v3-cluster/storage

# Rate limit (per-uploader, per-minute)
RATE_LIMIT_PER_MINUTE=60

# Trust forwarded headers (X-Forwarded-For) — set to 1 if behind nginx/cloudflare
TRUST_FORWARDED_HEADERS=0

# ---------- Worker ----------

# Gateway URL the worker connects to (must be reachable from worker)
GATEWAY_URL=http://100.90.235.15:8770

# Worker API key (created via /api/v1/admin/keys with role=worker)
WORKER_API_KEY=replace-me-with-64-hex-chars

# Worker identity (must be unique across cluster)
WORKER_ID=worker-rtx3050-01

# How many parallel jobs this worker can run
WORKER_MAX_PARALLEL=2

# Heartbeat interval (seconds)
WORKER_HEARTBEAT_INTERVAL=10

# Job claim poll interval (seconds)
WORKER_POLL_INTERVAL=3

# TC filter (comma-separated) — worker accepts only these TC types
# Leave empty to accept all
WORKER_TC_FILTER=tc01

# Optional: GPU label for display in UI
WORKER_GPU_LABEL=RTX 3050 8GB

# Local working dir (transient job files)
WORKER_WORK_DIR=/opt/v3-cluster/worker

# ffmpeg binary (use bundled or system)
FFMPEG_BIN=/usr/bin/ffmpeg
FFPROBE_BIN=/usr/bin/ffprobe
